    def init_db(self):
        """Initializes the SQLite database connection and creates tables if they don't exist."""
        try:
            self.conn = sqlite3.connect(self.data_file)
            self.cursor = self.conn.cursor()

            self.cursor.execute("""
                CREATE TABLE IF NOT EXISTS Projects (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT UNIQUE NOT NULL,
                    description TEXT DEFAULT ''
                )
            """)
            self.cursor.execute("PRAGMA table_info(Projects)")
            columns = [info[1] for info in self.cursor.fetchall()]
            if 'description' not in columns:
                self.cursor.execute("ALTER TABLE Projects ADD COLUMN description TEXT DEFAULT ''")
            
            # Create Tasks table with new 'remarks', 'completed_date', and 'parent_task_id' columns
            self.cursor.execute("""
                CREATE TABLE IF NOT EXISTS Tasks (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    project_id INTEGER,
                    task_name TEXT NOT NULL,
                    start_date TEXT NOT NULL,
                    end_date TEXT NOT NULL,
                    resource TEXT,
                    completion INTEGER,
                    remarks TEXT DEFAULT '',
                    completed_date TEXT,
                    parent_task_id INTEGER, -- New column for parent task ID
                    FOREIGN KEY (project_id) REFERENCES Projects(id) ON DELETE CASCADE,
                    FOREIGN KEY (parent_task_id) REFERENCES Tasks(id) ON DELETE CASCADE
                )
            """)
            # Add new columns if they don't exist (robustness for existing databases)
            self.cursor.execute("PRAGMA table_info(Tasks)")
            columns = [info[1] for info in self.cursor.fetchall()]
            if 'remarks' not in columns:
                self.cursor.execute("ALTER TABLE Tasks ADD COLUMN remarks TEXT DEFAULT ''")
            if 'completed_date' not in columns:
                self.cursor.execute("ALTER TABLE Tasks ADD COLUMN completed_date TEXT")
            if 'parent_task_id' not in columns:
                self.cursor.execute("ALTER TABLE Tasks ADD COLUMN parent_task_id INTEGER REFERENCES Tasks(id) ON DELETE CASCADE")


            self.conn.commit()

            self.cursor.execute("SELECT COUNT(*) FROM Projects")
            if self.cursor.fetchone()[0] == 0:
                self.cursor.execute("INSERT INTO Projects (name, description) VALUES (?, ?)", ("Default Project", "This is your default project. Feel free to rename or delete it once you've created others."))
                self.conn.commit()

        except sqlite3.Error as e:
            QMessageBox.critical(self, "Database Error", f"Failed to connect or initialize database: {e}")
            sys.exit(1)


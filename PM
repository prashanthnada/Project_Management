# --- TaskNode Class for Hierarchical Data ---
class TaskNode:
    """Represents a single task or subtask in the hierarchical tree."""
    def __init__(self, task_id, name, start, end, resource, completion, remarks, completed_date, parent=None, parent_db_id=None):
        self.task_id = task_id
        self.name = name
        self.start_date = start
        self.end_date = end
        self.resource = resource
        self.completion = completion
        self.remarks = remarks
        self.completed_date = completed_date
        self.parent = parent  # Reference to the parent TaskNode
        self.parent_db_id = parent_db_id # Stored for DB operations, can be None for top-level
        self.children = []    # List of child TaskNode objects

    def appendChild(self, node):
        """Adds a child node to this task."""
        self.children.append(node)
        # Optional: Sort children, e.g., by start date or name
        self.children.sort(key=lambda x: (x.start_date, x.name.lower()))

    def child(self, row):
        """Returns the child node at the given row index."""
        if row < 0 or row >= len(self.children):
            return None
        return self.children[row]

    def childCount(self):
        """Returns the number of children for this task."""
        return len(self.children)

    def columnCount(self):
        """Returns the number of data columns for this task (matches headers)."""
        # Increased by 1 for "Task No."
        return 10 # Task No., Task, Start Date, End Date, Duration, Pending, Resource, Completion, Remarks, Status

    def data(self, column):
        """Returns the data for a specific column."""
        today = date(2025, 7, 8) # Fixed to Tuesday, July 8, 2025 as per instruction
        try:
            start_dt = datetime.strptime(self.start_date, "%Y-%m-%d").date()
            end_dt = datetime.strptime(self.end_date, "%Y-%m-%d").date()
            duration = (end_dt - start_dt).days + 1
            pending_days = (end_dt - today).days
        except ValueError:
            duration = "N/A"
            pending_days = "N/A"

        # Determine task status for display
        status_text = ""

        # 1. Check for Completed status first (most restrictive)
        # A task is "Completed" only if its own completion is 100% AND all its descendants are 100%
        if self.completion == 100 and not self.has_incomplete_descendants():
            status_text = "Completed"
        # 2. Check for Overdue status (takes precedence over In Progress)
        # A task is Overdue if its own end date has passed AND it's not 100% complete
        # OR if any of its children (recursively) are overdue.
        elif self.is_overdue(today) or self.has_overdue_descendants(today):
            status_text = "Overdue"
        # 3. Check for In Progress status
        # A task is "In Progress" if its own completion is > 0% AND < 100%
        # OR if it has ANY descendant (direct or indirect) that is currently 'In Progress' or 'Overdue'.
        elif self.completion > 0 or self.has_any_child_in_progress_or_overdue(today): # Pass today's date
            status_text = "In Progress"
        # 4. Otherwise, it's "Not Started"
        else:
            status_text = "Not Started"

        if column == 0: return self.row() + 1 # Task Number (1-based index)
        elif column == 1: return self.name
        elif column == 2: return self.start_date
        elif column == 3: return self.end_date
        elif column == 4: return str(duration)
        elif column == 5: return str(pending_days) if isinstance(pending_days, int) else pending_days
        elif column == 6: return self.resource
        elif column == 7: return str(self.completion)
        elif column == 8: return self.remarks
        elif column == 9: return status_text
        return None

    def row(self):
        """Returns the row number of this task among its siblings."""
        if self.parent:
            return self.parent.children.index(self)
        return 0 # For root node (shouldn't happen for actual tasks in a QTreeView model)

    def is_overdue(self, current_date):
        """Checks if the task itself (not its children) is overdue."""
        if self.completion < 100:
            try:
                end_dt = datetime.strptime(self.end_date, "%Y-%m-%d").date()
                return (end_dt - current_date).days < 0
            except ValueError:
                return False
        return False
    
    def has_overdue_descendants(self, current_date):
        """Recursively checks if any direct or indirect child is overdue."""
        for child in self.children:
            if child.is_overdue(current_date):
                return True
            if child.has_overdue_descendants(current_date): # Recursive call
                return True
        return False

    def has_incomplete_descendants(self):
        """
        Recursively checks if this task or any of its children (and their children)
        are less than 100% complete.
        """
        if self.completion < 100:
            return True
        for child in self.children:
            if child.has_incomplete_descendants(): # Recursive call
                return True
        return False

    def has_any_child_in_progress_or_overdue(self, current_date):
        """
        Recursively checks if any direct or indirect child is 'In Progress' or 'Overdue'.
        This helps determine if a parent should be 'In Progress' even if its own completion is 0%.
        """
        for child in self.children:
            # Re-evaluate the child's status based on current_date
            child_status = ""
            if child.completion == 100 and not child.has_incomplete_descendants():
                child_status = "Completed"
            elif child.is_overdue(current_date) or child.has_overdue_descendants(current_date): # Check overdue for child and its descendants
                child_status = "Overdue"
            elif child.completion > 0 or child.has_any_child_in_progress_or_overdue(current_date): # Recursive check for children's status
                child_status = "In Progress"
            else:
                child_status = "Not Started"

            if child_status in ["In Progress", "Overdue"]:
                return True
        return False


    def get_display_color(self):
        """Returns the background color based on task status."""
        color_completed = QColor(198, 239, 206) # Lighter Green
        color_overdue = QColor(255, 204, 204)   # Lighter Red
        color_in_progress = QColor(255, 240, 180) # Lighter Yellow
        color_not_started = QColor(240, 248, 255) # Alice Blue (slightly off-white)

        today = date(2025, 7, 8) # Fixed to Tuesday, July 8, 2025 as per instruction

        # Apply the new status logic for coloring too
        # The logic here should mirror the data() method's status determination
        if self.completion == 100 and not self.has_incomplete_descendants():
            return color_completed
        elif self.is_overdue(today) or self.has_overdue_descendants(today): # Apply new overdue logic
            return color_overdue
        elif self.completion > 0 or self.has_any_child_in_progress_or_overdue(today): # Match new 'In Progress' logic, pass today's date
            return color_in_progress
        return color_not_started

# --- Custom QAbstractItemModel for Task Hierarchy ---
class TaskTreeModel(QAbstractItemModel):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.rootItem = TaskNode(None, "Root", "", "", "", 0, "", "", None) # Invisible root item
        # Updated column headers to include "Task No."
        self.column_headers = ["Task No.", "Task", "Start Date", "End Date", "Duration (Days)", "Pending Days", "Resource", "Completion %", "Remarks", "Status"]

        self._filter_text = ""
        self._filter_status = "All"
        self._filter_resource = "All"

    def columnCount(self, parent=QModelIndex()):
        return len(self.column_headers)

    def data(self, index, role=Qt.DisplayRole):
        if not index.isValid():
            return None

        node = index.internalPointer()

        if role == Qt.DisplayRole:
            return node.data(index.column())
        elif role == Qt.BackgroundRole:
            return QBrush(node.get_display_color())
        elif role == Qt.ForegroundRole and index.column() == 5: # Pending Days column (adjusted index for new column)
            # Use fixed date for is_overdue check
            today = date(2025, 7, 8)
            if node.is_overdue(today) or node.has_overdue_descendants(today): # Also highlight if child is overdue
                return QBrush(QColor("red"))
        elif role == Qt.ToolTipRole:
            today = date(2025, 7, 8)
            if index.column() == 5 and (node.is_overdue(today) or node.has_overdue_descendants(today)): # Adjusted index
                try:
                    end_dt = datetime.strptime(node.end_date, "%Y-%m-%d").date()
                    pending_days = (end_dt - today).days
                    return f"Overdue by {-pending_days} days!"
                except ValueError:
                    pass
            elif index.column() == 5 and node.completion < 100: # Adjusted index
                try:
                    end_dt = datetime.strptime(node.end_date, "%Y-%m-%d").date()
                    if (end_dt - today).days == 0:
                        return "Due today!"
                except ValueError:
                    pass
        elif role == Qt.TextAlignmentRole and index.column() == 8: # Remarks column (adjusted index)
            return int(Qt.AlignTop | Qt.AlignLeft)
        elif role == Qt.TextAlignmentRole and index.column() == 0: # Task No. column
            return int(Qt.AlignCenter)
        elif role == Qt.TextAlignmentRole and index.column() in [4, 5, 7]: # Duration, Pending, Completion %
            return int(Qt.AlignCenter)
        return None

    def headerData(self, section, orientation, role=Qt.DisplayRole):
        if orientation == Qt.Horizontal and role == Qt.DisplayRole:
            return self.column_headers[section]
        return None

    def index(self, row, column, parent=QModelIndex()):
        if not self.hasIndex(row, column, parent):
            return QModelIndex()

        parentNode = self.nodeFromIndex(parent)
        childNode = parentNode.child(row)
        if childNode:
            return self.createIndex(row, column, childNode)
        return QModelIndex()

    def parent(self, index):
        if not index.isValid():
            return QModelIndex()

        childNode = index.internalPointer()
        parentNode = childNode.parent

        if parentNode == self.rootItem:
            return QModelIndex()

        return self.createIndex(parentNode.row(), 0, parentNode)

    def rowCount(self, parent=QModelIndex()):
        if parent.column() > 0:
            return 0
        
        parentNode = self.nodeFromIndex(parent)
        return parentNode.childCount()

    def nodeFromIndex(self, index):
        if index.isValid():
            return index.internalPointer()
        return self.rootItem
    
    def setFilterText(self, text):
        if self._filter_text != text:
            self._filter_text = text
            # Do not emit layoutChanged directly here; it's handled by setupModelData

    def setFilterStatus(self, status):
        if self._filter_status != status:
            self._filter_status = status
            # Do not emit layoutChanged directly here; it's handled by setupModelData

    def setFilterResource(self, resource):
        if self._filter_resource != resource:
            self._filter_resource = resource
            # Do not emit layoutChanged directly here; it's handled by setupModelData

    def _passes_filter(self, node, current_date):
        """
        Checks if a single node (and its descendants) passes all current filters.
        This function is used to identify the "root" of a visible branch.
        """
        # Check if the node itself matches filters
        matches_text = (self._filter_text.lower() in node.name.lower() or 
                        self._filter_text.lower() in (node.resource.lower() if node.resource else '') or
                        self._filter_text.lower() in (node.remarks.lower() if node.remarks else ''))
        
        node_status = node.data(9) # Get the computed status of the node itself (column index 9 for Status)

        matches_status = (self._filter_status == "All" or node_status == self._filter_status)
        matches_resource = (self._filter_resource == "All" or 
                            (node.resource and node.resource.lower() == self._filter_resource.lower()))

        # A node passes if it directly matches filters
        if (matches_text or not self._filter_text) and \
           (matches_status or self._filter_status == "All") and \
           (matches_resource or self._filter_resource == "All"):
            return True

        # If this node doesn't match directly, check if any of its children match.
        # This ensures parent nodes are marked as "initially visible" if their *descendants* are part of the filter.
        for child in node.children: # NOTE: node.children here refer to the COMPLETE children list from the full tree
            if self._passes_filter(child, current_date): # Recursive call
                return True
        return False


    def setupModelData(self, tasks_data):
        """
        Builds the tree structure from a flat list of tasks data, applying filters.
        tasks_data: List of dictionaries, each representing a task from the DB,
                    including 'id' and 'parent_task_id'.
        """
        self.beginResetModel()
        self.rootItem = TaskNode(None, "Root", "", "", "", 0, "", "", None) # Invisible root item

        if not tasks_data:
            self.endResetModel()
            return

        # Phase 1: Build the complete, unfiltered hierarchy of all tasks in a temporary map.
        # This map will hold TaskNode objects with their full original hierarchy (children lists).
        nodes_by_id = {}
        for task_row in tasks_data:
            node = TaskNode(
                task_row["id"], task_row["task_name"], task_row["start_date"],
                task_row["end_date"], task_row["resource"], task_row["completion"],
                task_row["remarks"], task_row["completed_date"],
                parent_db_id=task_row["parent_task_id"]
            )
            nodes_by_id[task_row["id"]] = node

        # Establish parent-child relationships for the *full* tree using node references
        # Temporarily append them to the model's rootItem so we can traverse the full tree for filtering.
        # These are *references* to the nodes in nodes_by_id, not copies.
        for task_id, node in nodes_by_id.items():
            if node.parent_db_id is not None and node.parent_db_id in nodes_by_id:
                parent_node = nodes_by_id[node.parent_db_id]
                parent_node.appendChild(node)
                node.parent = parent_node # Set actual parent TaskNode reference
            else:
                self.rootItem.appendChild(node)
                node.parent = self.rootItem # Set actual parent TaskNode reference


        # Phase 2: Determine which nodes should be visible based on current filters.
        # A node is initially visible if it passes the filter directly OR if any of its descendants pass.
        # This set will contain matching nodes and their ancestors, forming the *paths* to matches.
        initially_visible_nodes_ids = set()
        today = date(2025, 7, 8) # Fixed date for status calculation

        # Traverse the temporarily built full tree from its top-level nodes (children of rootItem)
        # and identify all nodes (and their ancestors) that need to be initially visible to form the path.
        for node in self.rootItem.children: # These are the project's actual top-level tasks (from full tree)
            if self._passes_filter(node, today): # This recursive check pulls in ancestors
                current = node
                while current and current != self.rootItem:
                    initially_visible_nodes_ids.add(current.task_id)
                    current = current.parent


        # Phase 3: Construct the *final* visible tree structure for the QTreeView model.
        # Ensure that if a node is initially visible (part of a path to a match),
        # then *all* its descendants are also visible in the final model.
        
        # Clear the rootItem's children from the temporary full tree built in Phase 1.
        # This rootItem will now be rebuilt with the final visible structure.
        self.rootItem.children = [] 

        # Create new TaskNode objects for all tasks that should be in the final model.
        final_model_nodes_map = {}
        
        # Use a queue for a breadth-first traversal to collect all nodes that should be visible.
        # Start the queue with the IDs of nodes identified in Phase 2.
        queue_for_final_visibility = list(initially_visible_nodes_ids)
        # Keep track of IDs already added to final_model_nodes_map to avoid duplicates.
        added_to_final_model_map = set(initially_visible_nodes_ids)

        # First, add the 'initially_visible_nodes_ids' to the map, but don't link them yet.
        # We need them in the map before processing their children.
        for task_id in initially_visible_nodes_ids:
            original_node = nodes_by_id.get(task_id)
            if original_node: # Should always be true if initially_visible_nodes_ids is derived from nodes_by_id
                new_node = TaskNode(
                    original_node.task_id, original_node.name, original_node.start_date,
                    original_node.end_date, original_node.resource, original_node.completion,
                    original_node.remarks, original_node.completed_date,
                    parent_db_id=original_node.parent_db_id
                )
                final_model_nodes_map[task_id] = new_node

        # Now, process the queue to add all descendants of the initially visible nodes.
        while queue_for_final_visibility:
            current_id = queue_for_final_visibility.pop(0)
            original_node = nodes_by_id.get(current_id) # Get the original node from the full tree

            if original_node:
                for original_child in original_node.children:
                    if original_child.task_id not in added_to_final_model_map:
                        # This child is a descendant of a node already in the final model
                        # AND it hasn't been added yet. Add it and queue its children.
                        new_child_node = TaskNode(
                            original_child.task_id, original_child.name, original_child.start_date,
                            original_child.end_date, original_child.resource, original_child.completion,
                            original_child.remarks, original_child.completed_date,
                            parent_db_id=original_child.parent_db_id
                        )
                        final_model_nodes_map[original_child.task_id] = new_child_node
                        added_to_final_model_map.add(original_child.task_id)
                        queue_for_final_visibility.append(original_child.task_id) # Add child's ID to queue to process its children

        # Finally, link the new TaskNode objects in final_model_nodes_map to form the actual model tree.
        # Iterate through the original raw tasks_data to ensure correct parent_db_id matching and ordering.
        for task_row in tasks_data:
            task_id = task_row["id"]
            if task_id in final_model_nodes_map: # Only process tasks that are meant to be in the final model
                node = final_model_nodes_map[task_id]
                # If the node's original parent is also in the final_model_nodes_map, link it.
                if node.parent_db_id is not None and node.parent_db_id in final_model_nodes_map:
                    parent_node = final_model_nodes_map[node.parent_db_id]
                    parent_node.appendChild(node)
                    node.parent = parent_node # Set parent reference for model traversal
                else:
                    # Otherwise, it's a top-level visible task (either truly top-level or its parent wasn't visible
                    # but it's part of a branch that became visible, or it's just a top-level match).
                    self.rootItem.appendChild(node)
                    node.parent = self.rootItem # Set parent reference to the model's root

        self.endResetModel()

    def find_node_by_db_id(self, db_id):
        """Recursively finds a TaskNode by its database ID."""
        return self._find_node_recursive(self.rootItem, db_id)

    def _find_node_recursive(self, current_node, db_id):
        if current_node.task_id == db_id:
            return current_node
        for child in current_node.children:
            found_node = self._find_node_recursive(child, db_id)
            if found_node:
                return found_node
        return None

    def get_all_flat_tasks_data(self):
        """Returns a flat list of dictionaries for all tasks, including hierarchy info, from the *model's current visible data*."""
        flat_list = []
        def traverse(node, level=0):
            if node != self.rootItem:
                # Get the current displayed status, not recalculate
                status_at_display = node.data(9) # Column 9 is Status

                flat_list.append({
                    "id": node.task_id,
                    "task_name": node.name,
                    "start_date": node.start_date,
                    "end_date": node.end_date,
                    "resource": node.resource,
                    "completion": node.completion,
                    "remarks": node.remarks,
                    "completed_date": node.completed_date,
                    "parent_task_id": node.parent_db_id,
                    "level": level, # Useful for indentation in Gantt chart/Excel
                    "status_text": status_at_display # Include the calculated status
                })
            for child in node.children:
                traverse(child, level + 1)
        
        traverse(self.rootItem)
        return flat_list


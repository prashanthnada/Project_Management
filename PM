    def get_project_id(self, project_name):
        if not self.conn or not self.cursor: return None
        self.cursor.execute("SELECT id FROM Projects WHERE name = ?", (project_name,))
        result = self.cursor.fetchone()
        return result[0] if result else None

    def get_project_name_by_id(self, project_id):
        if not self.conn or not self.cursor: return None
        self.cursor.execute("SELECT name FROM Projects WHERE id = ?", (project_id,))
        result = self.cursor.fetchone()
        return result[0] if result else None
    
    def on_project_selection_changed(self):
        # Reset filters when project changes
        self.search_task_input.clear()
        self.filter_status_combo.setCurrentIndex(0) # "All"
        self.filter_resource_combo.setCurrentIndex(0) # "All"
        # The above will trigger apply_filters, which calls load_tasks_for_selected_project()
        # So we just need to ensure initial load happens without filters interfering
        self.load_tasks_for_selected_project()
        self.load_project_description()
        self.update_project_status() # Status update after tasks are loaded
        self.populate_parent_task_selector() # Refresh parent task selector when project changes
        self.load_all_resources() # Reload all resources from DB for filtering/input

    def populate_project_selector(self):
        self.project_selector.clear()
        if not self.conn or not self.cursor: return

        try:
            self.cursor.execute("SELECT name FROM Projects ORDER BY name COLLATE NOCASE")
            project_names = [row[0] for row in self.cursor.fetchall()]
            
            self.project_selector.blockSignals(True)
            for name in project_names:
                self.project_selector.addItem(name)
            self.project_selector.blockSignals(False)

            if project_names:
                current_text = self.project_selector.currentText()
                if current_text and current_text in project_names:
                    self.project_selector.setCurrentText(current_text)
                else:
                    self.project_selector.setCurrentIndex(0)
            
            # This will trigger on_project_selection_changed, which then loads tasks and applies filters
            self.on_project_selection_changed()

        except sqlite3.Error as e:
            QMessageBox.critical(self, "Database Error", f"Failed to load projects: {e}")
            self.project_selector.addItem("Error Loading Projects")

    def add_project(self):
        project_name = self.new_project_input.text().strip()
        if not project_name:
            QMessageBox.warning(self, "Input Error", "Project name cannot be empty.")
            return

        try:
            self.cursor.execute("INSERT INTO Projects (name) VALUES (?)", (project_name,))
            self.conn.commit()
            self.populate_project_selector()
            self.project_selector.setCurrentText(project_name)
            self.new_project_input.clear()
            QMessageBox.information(self, "Success", f"Project '{project_name}' added successfully.")
        except sqlite3.IntegrityError:
            QMessageBox.warning(self, "Duplicate Project", f"Project '{project_name}' already exists.")
        except sqlite3.Error as e:
            QMessageBox.critical(self, "Database Error", f"Failed to add project: {e}")

    def edit_project_name(self):
        current_name = self.project_selector.currentText()
        if not current_name:
            QMessageBox.warning(self, "Selection Error", "No project selected to edit.")
            return

        new_name, ok = QInputDialog.getText(self, "Edit Project Name", "Enter new name for project:",
                                          QLineEdit.Normal, current_name)

        if ok and new_name and new_name.strip() != current_name:
            new_name = new_name.strip()
            project_id = self.get_project_id(current_name)
            if not project_id:
                QMessageBox.warning(self, "Error", "Selected project not found in database.")
                return
            
            try:
                self.cursor.execute("UPDATE Projects SET name = ? WHERE id = ?", (new_name, project_id))
                self.conn.commit()
                QMessageBox.information(self, "Success", f"Project name updated from '{current_name}' to '{new_name}'.")
                
                self.populate_project_selector()
                idx = self.project_selector.findText(new_name)
                if idx != -1:
                    self.project_selector.setCurrentIndex(idx)
                
            except sqlite3.IntegrityError:
                QMessageBox.warning(self, "Duplicate Name", f"Project name '{new_name}' already exists.")
            except sqlite3.Error as e:
                QMessageBox.critical(self, "Database Error", f"Failed to update project name: {e}")
        elif ok and new_name.strip() == current_name:
            QMessageBox.information(self, "No Change", "Project name is the same as before.")

    def delete_current_project(self):
        project_name = self.project_selector.currentText()
        if not project_name:
            QMessageBox.warning(self, "Selection Error", "No project selected to delete.")
            return

        project_id = self.get_project_id(project_name)
        if project_id is None:
            QMessageBox.warning(self, "Error", "Selected project not found in database.")
            return

        self.cursor.execute("SELECT COUNT(*) FROM Projects")
        project_count = self.cursor.fetchone()[0]

        if project_count <= 1:
            QMessageBox.warning(self, "Cannot Delete", "You cannot delete the last project. Please create at least one new project before attempting to delete this one.")
            return

        reply = QMessageBox.question(self, "Confirm Deletion",
                                f"Are you sure you want to delete the project '{project_name}' and all its tasks? This action cannot be undone.",
                                QMessageBox.Yes | QMessageBox.No)
        if reply == QMessageBox.Yes:
            try:
                self.cursor.execute("DELETE FROM Projects WHERE id = ?", (project_id,))
                self.conn.commit()
                QMessageBox.information(self, "Deletion Successful", f"Project '{project_name}' deleted.")
                self.populate_project_selector()
            except sqlite3.Error as e:
                QMessageBox.critical(self, "Database Error", f"Failed to delete project: {e}")

    def load_all_resources(self):
        """Loads all unique resources from the Tasks table for both input and filter comboboxes."""
        self.all_resources.clear()
        if not self.conn or not self.cursor: return

        try:
            self.cursor.execute("SELECT DISTINCT resource FROM Tasks WHERE resource IS NOT NULL AND resource != ''")
            for row in self.cursor.fetchall():
                self.all_resources.add(row[0])
            
            # Update the resource input combobox
            current_resource_text = self.resource.currentText()
            self.resource.clear()
            self.resource.addItems(sorted(list(self.all_resources)))
            if current_resource_text in self.all_resources:
                self.resource.setCurrentText(current_resource_text)
            else:
                self.resource.setEditText("") # Clear if not found

            # Update the filter resource combobox
            current_filter_resource = self.filter_resource_combo.currentText()
            self.filter_resource_combo.blockSignals(True) # Prevent recursive calls
            self.filter_resource_combo.clear()
            self.filter_resource_combo.addItem("All")
            self.filter_resource_combo.addItems(sorted(list(self.all_resources)))
            if current_filter_resource in self.all_resources or current_filter_resource == "All":
                self.filter_resource_combo.setCurrentText(current_filter_resource)
            else:
                self.filter_resource_combo.setCurrentIndex(0) # Select "All"
            self.filter_resource_combo.blockSignals(False)

        except sqlite3.Error as e:
            print(f"Error loading resources: {e}")

    def load_project_description(self):
        project_name = self.project_selector.currentText()
        project_id = self.get_project_id(project_name)
        if project_id:
            try:
                self.cursor.execute("SELECT description FROM Projects WHERE id = ?", (project_id,))
                description = self.cursor.fetchone()[0]
                self.project_description_text.blockSignals(True)
                self.project_description_text.setText(description or "")
                self.project_description_text.blockSignals(False)
            except sqlite3.Error as e:
                print(f"Error loading project description: {e}")
                self.project_description_text.setText("Error loading description.")
        else:
            self.project_description_text.clear()

    def save_project_description_on_change(self):
        project_name = self.project_selector.currentText()
        project_id = self.get_project_id(project_name)
        if project_id:
            description = self.project_description_text.toPlainText()
            try:
                self.cursor.execute("UPDATE Projects SET description = ? WHERE id = ?", (description, project_id))
                self.conn.commit()
            except sqlite3.Error as e:
                print(f"Error saving project description: {e}")

    def populate_parent_task_selector(self):
        """Populates the parent task dropdown with current project's tasks."""
        self.parent_task_selector.blockSignals(True)
        self.parent_task_selector.clear()
        self.parent_task_selector.addItem("--- No Parent ---", userData=None) # Option for top-level task

        # Get all tasks for the current project from the raw data (unfiltered)
        # This ensures all tasks can be selected as parents, even if currently filtered out
        all_tasks_for_project = []
        project_name = self.project_selector.currentText()
        project_id = self.get_project_id(project_name)
        if project_id:
            try:
                self.cursor.execute("""
                    SELECT id, task_name, start_date, end_date, resource, completion, remarks, completed_date, parent_task_id
                    FROM Tasks
                    WHERE project_id = ?
                    ORDER BY start_date, task_name COLLATE NOCASE
                """, (project_id,))
                task_columns = ["id", "task_name", "start_date", "end_date", "resource", "completion", "remarks", "completed_date", "parent_task_id"]
                all_tasks_for_project = [dict(zip(task_columns, row)) for row in self.cursor.fetchall()]
            except sqlite3.Error as e:
                print(f"Error loading tasks for parent selector: {e}")
        
        # Build a temporary TaskNode structure to determine levels for indentation
        temp_root = TaskNode(None, "TempRoot", "", "", "", 0, "", "", None)
        temp_nodes = {}
        for task_row in all_tasks_for_project:
            node = TaskNode(
                task_row["id"], task_row["task_name"], task_row["start_date"], 
                task_row["end_date"], task_row["resource"], task_row["completion"], 
                task_row["remarks"], task_row["completed_date"], parent_db_id=task_row["parent_task_id"]
            )
            temp_nodes[task_row["id"]] = node

        # Link parents for temporary structure
        for task_row in all_tasks_for_project:
            node = temp_nodes[task_row["id"]]
            parent_id = task_row["parent_task_id"]
            if parent_id is None:
                temp_root.appendChild(node)
                node.parent = temp_root
            elif parent_id in temp_nodes:
                parent_node = temp_nodes[parent_id]
                parent_node.appendChild(node)
                node.parent = parent_node
            else:
                temp_root.appendChild(node) # Orphaned tasks to root

        # Recursively get flat data with levels from the temporary tree
        temp_flat_data_with_levels = []
        def _get_temp_flat(node, level=0):
            if node != temp_root:
                temp_flat_data_with_levels.append({
                    "id": node.task_id,
                    "task_name": node.name,
                    "level": level
                })
            for child in node.children:
                _get_temp_flat(child, level + 1)
        _get_temp_flat(temp_root)


        # Add tasks to the selector, indenting names for subtasks
        for task_data in temp_flat_data_with_levels:
            indentation = "  " * task_data.get("level", 0) 
            display_name = f"{indentation}{task_data['task_name']}"
            self.parent_task_selector.addItem(display_name, userData=task_data["id"])
        
        self.parent_task_selector.blockSignals(False)

    def load_tasks_for_selected_project(self):
        """Loads tasks for the selected project into the QTreeView (unfiltered raw data)."""
        project_name = self.project_selector.currentText()
        project_id = self.get_project_id(project_name)

        self.current_project_tasks_raw = [] # Reset raw data

        if not project_id:
            self.task_model.setupModelData([]) # Clear the model
            self.clear_task_input_fields()
            self.update_project_status()
            return

        try:
            self.cursor.execute("""
                SELECT id, task_name, start_date, end_date, resource, completion, remarks, completed_date, parent_task_id
                FROM Tasks
                WHERE project_id = ?
                ORDER BY start_date, task_name COLLATE NOCASE
            """, (project_id,))
            tasks_data = self.cursor.fetchall()

            # Convert to list of dicts for easier processing
            task_columns = ["id", "task_name", "start_date", "end_date", "resource", "completion", "remarks", "completed_date", "parent_task_id"]
            self.current_project_tasks_raw = [dict(zip(task_columns, row)) for row in tasks_data]
            
            self.apply_filters() # Apply current filters after raw data is loaded

        except sqlite3.Error as e:
            QMessageBox.critical(self, "Database Error", f"Failed to load tasks: {e}")
            self.task_model.setupModelData([]) # Clear model on error
            self.current_project_tasks_raw = []
        except Exception as e:
            QMessageBox.critical(self, "Data Processing Error", f"Error displaying tasks: {e}")

    def apply_filters(self):
        """Applies the current search and filter settings to the tree view."""
        self.task_model.setFilterText(self.search_task_input.text())
        self.task_model.setFilterStatus(self.filter_status_combo.currentText())
        self.task_model.setFilterResource(self.filter_resource_combo.currentText())
        
        # Pass the raw (unfiltered) data to the model. The model will handle filtering internally.
        self.task_model.setupModelData(self.current_project_tasks_raw)
        
        self.tree_view.expandAll() # Expand all visible nodes to show sub-tasks
        
        for i in range(self.task_model.columnCount()):
            self.tree_view.resizeColumnToContents(i)
        
        self.clear_task_input_fields() # Clear inputs after filtering (as selection might be gone)
        self.update_project_status() # Re-calculate project status with visible tasks (if relevant, though project status is total)

    def update_project_status(self):
        """
        Determines overall project status based on hierarchical task completion (all tasks, not filtered).
        A project is 'Completed' only if ALL its tasks (including all subtasks) are 100% complete.
        """
        # We need to get the status from the full, unfiltered data set
        # Recreate a temporary root for unfiltered data for status calculation
        temp_root_unfiltered = TaskNode(None, "Root", "", "", "", 0, "", "", None)
        all_nodes_unfiltered = {}
        
        # First pass: Create all nodes
        for task_row in self.current_project_tasks_raw:
            node = TaskNode(
                task_row["id"], task_row["task_name"], task_row["start_date"], task_row["end_date"],
                task_row["resource"], task_row["completion"], task_row["remarks"], task_row["completed_date"],
                parent_db_id=task_row["parent_task_id"]
            )
            all_nodes_unfiltered[task_row["id"]] = node

        # Second pass: Link children to parents and add top-level to temp_root
        for task_row in self.current_project_tasks_raw:
            node = all_nodes_unfiltered[task_row["id"]]
            parent_id = task_row["parent_task_id"]
            if parent_id is None:
                temp_root_unfiltered.appendChild(node)
                node.parent = temp_root_unfiltered
            elif parent_id in all_nodes_unfiltered:
                parent_node = all_nodes_unfiltered[parent_id]
                parent_node.appendChild(node)
                node.parent = parent_node
            else:
                temp_root_unfiltered.appendChild(node) # Orphaned tasks to root


        if not self.current_project_tasks_raw:
            self.project_status_label.setText("No Tasks Yet")
            self.project_status_label.setStyleSheet("QLabel#projectStatusLabel { background-color: #6c757d; }")
            return

        # Initialize status flags for the entire project
        has_any_incomplete_task = False
        has_overdue_tasks = False
        has_in_progress_tasks = False 

        today = date(2025, 7, 8) # Fixed to Tuesday, July 8, 2025

        def traverse_for_project_status(node):
            nonlocal has_any_incomplete_task, has_overdue_tasks, has_in_progress_tasks
            if node != temp_root_unfiltered: # Skip the invisible root node
                if node.completion < 100:
                    has_any_incomplete_task = True

                # Check if this node or any of its descendants are overdue
                if node.is_overdue(today) or node.has_overdue_descendants(today): 
                    has_overdue_tasks = True

                # Check for in-progress status for this specific node or its descendants
                if (node.completion > 0 and node.completion < 100) or node.has_any_child_in_progress_or_overdue(today):
                    has_in_progress_tasks = True

            for child in node.children:
                traverse_for_project_status(child) # Recursively check children

        traverse_for_project_status(temp_root_unfiltered)

        status_text = ""
        status_style = ""

        # Determine overall project status hierarchy
        if not has_any_incomplete_task and temp_root_unfiltered.childCount() > 0:
            status_text = "Completed"
            status_style = "QLabel#projectStatusLabel { background-color: #28a745; }" # Green
        elif has_overdue_tasks:
            status_text = "Overdue"
            status_style = "QLabel#projectStatusLabel { background-color: #dc3545; }" # Red
        elif has_in_progress_tasks:
            status_text = "In Progress"
            status_style = "QLabel#projectStatusLabel { background-color: #007bff; }" # Blue
        else: # All tasks are 0% and not overdue, or no tasks exist
            status_text = "Not Yet Started"
            status_style = "QLabel#projectStatusLabel { background-color: #6c757d; }" # Grey

        self.project_status_label.setText(status_text)
        self.project_status_label.setStyleSheet(status_style)


    def clear_task_input_fields(self):
        """Clears the task input fields and resets the add/update button."""
        self.task_name.clear()
        self.start_date.setDate(QDate.currentDate())
        self.end_date.setDate(QDate.currentDate().addDays(7))
        
        self.resource.setEditText("")
        self.completion.setText("0")
        self.remarks.clear()
        self.parent_task_selector.setCurrentIndex(0) # Select "--- No Parent ---"
        self.selected_task_node = None
        self.add_update_task_btn.setText("Add Task")
        self.add_update_task_btn.setToolTip("Add a new task to the current project")
        self.tree_view.clearSelection()

    def load_task_to_fields(self, index):
        """Loads data from the clicked tree view item into the input fields for editing."""
        if not index.isValid():
            self.clear_task_input_fields()
            return

        node = self.task_model.nodeFromIndex(index)
        self.selected_task_node = node # Store the selected TaskNode object

        self.task_name.setText(node.name)
        self.start_date.setDate(QDate.fromString(node.start_date, "yyyy-MM-dd"))
        self.end_date.setDate(QDate.fromString(node.end_date, "yyyy-MM-dd"))
        
        self.resource.setEditText(node.resource or "") # Handle None
        self.completion.setText(str(node.completion))
        self.remarks.setText(node.remarks or "") # Handle None

        # Set the parent task selector
        parent_id = node.parent_db_id
        if parent_id is None:
            self.parent_task_selector.setCurrentIndex(0) # "--- No Parent ---"
        else:
            # Find the index of the parent in the combo box by userData (task_id)
            idx = self.parent_task_selector.findData(parent_id)
            if idx != -1:
                self.parent_task_selector.setCurrentIndex(idx)
            else:
                self.parent_task_selector.setCurrentIndex(0) # Fallback if parent not found

        self.add_update_task_btn.setText("Update Task")
        self.add_update_task_btn.setToolTip(f"Update selected task (ID: {node.task_id})")

    def add_or_update_task(self):
        """Handles adding a new task or updating an existing one."""
        project_name = self.project_selector.currentText()
        project_id = self.get_project_id(project_name)
        if not project_id:
            QMessageBox.warning(self, "Selection Error", "Please select or create a project first.")
            return

        task = self.task_name.text().strip()
        start = self.start_date.date().toString("yyyy-MM-dd")
        end = self.end_date.date().toString("yyyy-MM-dd")
        resource = self.resource.currentText().strip() or None # Store empty string as None
        completion_str = self.completion.text().strip()
        remarks = self.remarks.toPlainText().strip() or None # Store empty string as None

        # Get parent task ID from the selector
        parent_task_id = self.parent_task_selector.currentData() # This will be None for "--- No Parent ---"

        if not task:
            QMessageBox.warning(self, "Input Error", "Task name cannot be empty.")
            return

        if self.start_date.date() > self.end_date.date():
            QMessageBox.warning(self, "Date Error", "End date cannot be before start date.")
            return

        try:
            completion = int(completion_str)
            if not (0 <= completion <= 100):
                raise ValueError
        except ValueError:
            QMessageBox.warning(self, "Input Error", "Completion percentage must be a number between 0 and 100.")
            return

        # Prevent a task from being its own parent
        if self.selected_task_node and parent_task_id == self.selected_task_node.task_id:
            QMessageBox.warning(self, "Parent Error", "A task cannot be its own parent.")
            return
        
        # Prevent a task from being a parent of its own ancestor (create a loop)
        if self.selected_task_node and parent_task_id:
            # We need to check against the full raw data, not just what's currently filtered
            # Create a temporary TaskNode structure from current_project_tasks_raw for path checking
            temp_all_nodes = {}
            temp_root = TaskNode(None, "TempRoot", "", "", "", 0, "", "", None)
            
            for task_row in self.current_project_tasks_raw:
                node = TaskNode(task_row["id"], "", "", "", "", 0, "", "", parent_db_id=task_row["parent_task_id"])
                temp_all_nodes[task_row["id"]] = node
            
            # Link children for correct parent traversal for all tasks
            for task_id, node_obj in temp_all_nodes.items():
                if node_obj.parent_db_id is not None and node_obj.parent_db_id in temp_all_nodes:
                    temp_all_nodes[node_obj.parent_db_id].appendChild(node_obj)
                    node_obj.parent = temp_all_nodes[node_obj.parent_db_id]
                else:
                    temp_root.appendChild(node_obj) # Add top-level tasks to a dummy root for traversal
                    node_obj.parent = temp_root

            target_parent_node = temp_all_nodes.get(parent_task_id)
            if target_parent_node:
                current = target_parent_node
                while current and current.task_id != self.selected_task_node.task_id and current != temp_root:
                    current = current.parent # Traverse up
                    if current and current.task_id == self.selected_task_node.task_id:
                        QMessageBox.warning(self, "Parent Error", "Circular dependency detected! A task cannot be a parent of its own ancestor.")
                        return

        completed_date = None
        if completion == 100:
            if self.selected_task_node and self.selected_task_node.completion == 100 and self.selected_task_node.completed_date:
                completed_date = self.selected_task_node.completed_date # Keep original completed date if already 100%
            else:
                completed_date = date(2025, 7, 8).strftime("%Y-%m-%d") # Use fixed date
        elif self.selected_task_node and self.selected_task_node.completion == 100 and completion < 100:
            completed_date = None # Clear completed date if completion drops from 100%
        elif self.selected_task_node:
            completed_date = self.selected_task_node.completed_date # Maintain existing if not 100%


        try:
            if self.selected_task_node is None:
                # Add new task
                self.cursor.execute("""
                    INSERT INTO Tasks (project_id, task_name, start_date, end_date, resource, completion, remarks, completed_date, parent_task_id)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                """, (project_id, task, start, end, resource, completion, remarks, completed_date, parent_task_id))
                self.conn.commit()
                QMessageBox.information(self, "Task Added", f"Task '{task}' added to '{project_name}'.")
            else:
                # Update existing task
                self.cursor.execute("""
                    UPDATE Tasks SET task_name = ?, start_date = ?, end_date = ?, resource = ?, completion = ?, remarks = ?, completed_date = ?, parent_task_id = ?
                    WHERE id = ? AND project_id = ?
                """, (task, start, end, resource, completion, remarks, completed_date, parent_task_id, self.selected_task_node.task_id, project_id))
                self.conn.commit()
                if self.cursor.rowcount > 0:
                    QMessageBox.information(self, "Task Updated", f"Task '{task}' updated in '{project_name}'.")
                else:
                    QMessageBox.warning(self, "Update Error", "Could not update task. It might have been deleted by another action or the data was unchanged.")

            self.load_all_resources() # Refresh resource list (for input and filter)
            self.load_tasks_for_selected_project() # Reload all tasks to refresh hierarchy and re-apply filters
            self.clear_task_input_fields()
            self.update_project_status() # Re-calculate project status after changes
            
            self.populate_parent_task_selector() # Refresh parent task dropdown after task changes

        except sqlite3.Error as e:
            QMessageBox.critical(self, "Database Error", f"Failed to add/update task: {e}")
        except Exception as e:
            QMessageBox.critical(self, "Application Error", f"An unexpected error occurred: {e}")


    def delete_selected_tasks(self):
        project_name = self.project_selector.currentText()
        project_id = self.get_project_id(project_name)
        if not project_id:
            QMessageBox.warning(self, "Selection Error", "No project selected.")
            return

        selected_indexes = self.tree_view.selectedIndexes()
        if not selected_indexes:
            QMessageBox.warning(self, "Selection Error", "Please select at least one task to delete.")
            return

        # Get unique top-level nodes of selected items to avoid deleting children multiple times
        selected_nodes = set()
        for index in selected_indexes:
            if index.column() == 0: # Only process the first column index to get the node once
                selected_nodes.add(self.task_model.nodeFromIndex(index))
        
        if not selected_nodes:
            QMessageBox.warning(self, "Deletion Error", "No valid tasks selected for deletion.")
            return

        # Extract the database IDs of the selected nodes
        tasks_to_delete_ids = [node.task_id for node in selected_nodes if node.task_id is not None]

        if not tasks_to_delete_ids:
            QMessageBox.warning(self, "Deletion Error", "No valid tasks with database IDs selected for deletion.")
            return

        reply = QMessageBox.question(self, "Confirm Deletion",
                                f"Are you sure you want to delete {len(tasks_to_delete_ids)} selected task(s) and their subtasks (if any)? This action cannot be undone.",
                                QMessageBox.Yes | QMessageBox.No)
        if reply == QMessageBox.Yes:
            try:
                self.conn.execute("BEGIN TRANSACTION")
                
                for task_db_id in tasks_to_delete_ids:
                    # Due to ON DELETE CASCADE, deleting a parent task will automatically delete its children
                    self.cursor.execute("DELETE FROM Tasks WHERE id = ? AND project_id = ?", (task_db_id, project_id))

                self.conn.commit()
                QMessageBox.information(self, "Deletion Successful", f"{len(tasks_to_delete_ids)} top-level task(s) (and their subtasks) deleted.")

                self.load_all_resources() # Refresh resource list
                self.load_tasks_for_selected_project() # Reload all tasks to refresh hierarchy and re-apply filters
                self.clear_task_input_fields()
                self.update_project_status() # Re-calculate project status after deletion

            except sqlite3.Error as e:
                self.conn.rollback()
                QMessageBox.critical(self, "Database Error", f"Failed to delete tasks: {e}")

    def generate_and_open_gantt_chart(self):
        project_name = self.project_selector.currentText()
        if not project_name:
            QMessageBox.warning(self, "No Data", "No project selected to generate a Gantt chart.")
            return

        # Get all tasks in a flat list from the model (includes level for indentation)
        # Use current filtered/displayed data for Gantt chart
        tasks_flat_data = self.task_model.get_all_flat_tasks_data()
        if not tasks_flat_data:
            QMessageBox.information(self, "No Tasks", "No tasks available for the current project to create a Gantt chart.")
            return

        # Prepare data for DataFrame, adding indentation to task names
        gantt_data = []
        for task in tasks_flat_data:
            indentation = "  " * task.get("level", 0)
            display_name = f"{indentation}{task['task_name']}"
            gantt_data.append({
                'Task': display_name,
                'Start': task['start_date'],
                'Finish': task['end_date'],
                'Resource': task['resource'],
                'Completion': task['completion'],
                'Remarks': task['remarks'],
                'Status': task['status_text'] # Use the calculated status
            })
        
        df = pd.DataFrame(gantt_data)

        try:
            df['Start'] = pd.to_datetime(df['Start'], errors='coerce')
            df['Finish'] = pd.to_datetime(df['Finish'], errors='coerce')
            df.dropna(subset=['Start', 'Finish'], inplace=True)

            if df.empty:
                QMessageBox.warning(self, "Gantt Chart Error", "No valid task dates found for Gantt chart generation after processing. Please check task dates.")
                return

        except Exception as e:
            QMessageBox.critical(self, "Date Processing Error", f"Failed to process dates for Gantt chart: {e}")
            return

        try:
            # Define color map for Gantt chart based on status
            color_map = {
                "Completed": "#28a745",    # Green
                "Overdue": "#dc3545",      # Red (for overdue tasks)
                "In Progress": "#007bff",  # Blue
                "Not Started": "#6c757d"   # Grey
            }

            fig = px.timeline(df, x_start="Start", x_end="Finish", y="Task", color="Status", # Color by Status
                              color_discrete_map=color_map, # Apply specific colors from our map
                              hover_data={"Start": "|%Y-%m-%d",
                                          "Finish": "|%Y-%m-%d",
                                          "Completion": True,
                                          "Resource": True,
                                          "Remarks": True,
                                          "Status": True}, # Include Status in hover data
                              title=f"<b>Gantt Chart: {project_name}</b>")

            fig.update_yaxes(autorange="reversed", title_text="Task")
            fig.update_xaxes(title_text="Date")
            fig.update_layout(
                font_family="Segoe UI",
                title_font_size=24,
                title_font_color="#333",
                xaxis_title_font_size=16,
                yaxis_title_font_size=16,
                xaxis=dict(showgrid=True, gridcolor='#e0e0e0'),
                yaxis=dict(showgrid=True, gridcolor='#e0e0e0'),
                plot_bgcolor='white',
                paper_bgcolor='#f0f2f5',
                margin=dict(l=50, r=50, t=90, b=50),
                hoverlabel=dict(bgcolor="white", font_size=14, font_family="Segoe UI")
            )

            html_string = fig.to_html(include_plotlyjs='cdn')

            with tempfile.NamedTemporaryFile(delete=False, suffix=".html", mode='w', encoding='utf-8') as f:
                f.write(html_string)
                file_path = f.name
            
            webbrowser.open_new_tab(f"file:///{file_path.replace(os.sep, '/')}")
            QMessageBox.information(self, "Chart Opened", f"Gantt chart opened in your default web browser.\nTemporary file: {file_path}")

        except Exception as e:
            QMessageBox.critical(self, "Gantt Chart Error", f"Failed to generate or open Gantt chart in browser: {e}")

    def export_to_excel(self):
        project_name = self.project_selector.currentText()
        if not project_name:
            QMessageBox.warning(self, "No Data", "No project selected to export.")
            return

        # Get all tasks in a flat list from the model's *current visible data*
        # This will export the filtered view
        tasks_to_export = self.task_model.get_all_flat_tasks_data()
        
        if not tasks_to_export:
            QMessageBox.warning(self, "No Data", "No tasks to export for the current project (or no tasks match current filters).")
            return

        path, _ = QFileDialog.getSaveFileName(self, "Save Project Tasks", f"{project_name}_tasks.xlsx", "Excel Files (*.xlsx)")
        if path:
            df = pd.DataFrame(tasks_to_export)

            if not df.empty:
                try:
                    df['start_date'] = pd.to_datetime(df['start_date'], errors='coerce')
                    df['end_date'] = pd.to_datetime(df['end_date'], errors='coerce')

                    initial_rows = len(df)
                    df.dropna(subset=['start_date', 'end_date'], inplace=True)
                    if len(df) < initial_rows:
                        QMessageBox.warning(self, "Data Warning", 
                                            f"Some tasks were skipped from export due to invalid or missing start/end dates. "
                                            f"Original: {initial_rows}, Exported: {len(df)}.")
                    
                    if df.empty:
                        QMessageBox.information(self, "Export Cancelled", "No valid tasks with dates found to export after cleaning.")
                        return

                    today_timestamp = pd.Timestamp(date(2025, 7, 8)) # Use fixed date

                    df['Duration (Days)'] = (df['end_date'] - today_timestamp).dt.days + 1
                    df['Pending Days'] = (df['end_date'] - today_timestamp).dt.days
                    
                    # Add indentation to Task Name for hierarchical representation in Excel
                    df['Task No.'] = df.apply(lambda row: row['level'] * "  " + str(df.loc[:row.name].loc[df['level'] == row['level']].shape[0]) if row['level'] > 0 else str(df.loc[:row.name].loc[df['level'] == 0].shape[0]), axis=1)

                    df['Task Name (Hierarchical)'] = df.apply(
                        lambda row: ("  " * row.get('level', 0)) + row['task_name'], axis=1
                    )

                    export_columns = [
                        "Task No.", "Task Name (Hierarchical)", "task_name", "start_date", "end_date", "Duration (Days)", "Pending Days",
                        "resource", "completion", "remarks", "completed_date", "status_text", "id", "parent_task_id"
                    ]
                    
                    # Ensure all columns exist before selecting
                    for col in export_columns:
                        if col not in df.columns:
                            df[col] = None

                    df_export = df[export_columns]
                    
                    df_export = df_export.rename(columns={
                        'task_name': 'Task Name (Flat)', # Renamed for clarity in Excel
                        'start_date': 'Start Date',
                        'end_date': 'End Date',
                        'resource': 'Resource',
                        'completion': 'Completion %',
                        'remarks': 'Remarks',
                        'completed_date': 'Completed Date',
                        'status_text': 'Status',
                        'id': 'Task ID',
                        'parent_task_id': 'Parent Task ID'
                    })

                    df_export.to_excel(path, index=False)
                    QMessageBox.information(self, "Export Successful", f"Tasks exported to:\n{path}")
                except PermissionError:
                    QMessageBox.critical(self, "Export Error", f"Permission denied. Please close the Excel file if it's open and try again, or save to a different location.")
                except Exception as e:
                    QMessageBox.critical(self, "Export Error", f"Failed to export tasks to Excel: {e}")
            else:
                QMessageBox.information(self, "Export Info", "No tasks to export for this project.")

